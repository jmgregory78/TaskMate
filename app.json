{
  "expo": {
    "name": "TaskMate",
    "slug": "TaskMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D3748"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jmgregory78.TaskMate",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0D9488"
        }
      ]
    ],
    "extra": {
      "internalVersion": "4.035",
      "eas": {
        "projectId": "26d9eb72-7f17-4bfe-9603-4364feaa3bc1"
      }
    }
  }
}